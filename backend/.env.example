# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS configuration)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projects_db
DB_USER=postgres
DB_PASSWORD=postgres

# Alternative single connection string (recommended for Neon, Supabase, Render, etc.)
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_phase1_change_in_production
JWT_EXPIRES_IN=7d

# Web Push VAPID Configuration (generate using: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@pmckb.com

# Email Service Configuration (Team Invitations & Notifications)
# For development using Gmail SMTP, generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords (Requires Google 2-Step Verification)
EMAIL_PROVIDER=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
EMAIL_FROM_NAME=PMCKB
EMAIL_FROM_ADDRESS=your_email@gmail.com
FRONTEND_URL=http://localhost:5173


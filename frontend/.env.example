# PMCKB Frontend Environment Configuration Example

# Backend API Base URL
# For local PC only development:
# VITE_API_URL=http://localhost:5000
# For mobile phone testing over the same Wi-Fi / Local Area Network:
# VITE_API_URL=http://<YOUR_PC_LAN_IP>:5000 (e.g. http://192.168.0.122:5000)
# For production deployment:
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
